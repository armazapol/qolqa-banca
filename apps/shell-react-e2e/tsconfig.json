{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "outDir": "out-tsc/playwright",
    "sourceMap": false,
    // Playwright transpila los specs por su cuenta: imports sin extensión, como en un bundler.
    "module": "esnext",
    "moduleResolution": "bundler",
    // DOM: el código de page.evaluate / addInitScript corre en el navegador.
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node"]
  },
  "include": ["playwright.config.mts", "src/**/*.ts", "support/**/*.mjs"],
  "exclude": ["out-tsc", "test-output"]
}
