NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://qolqa:qolqa_dev_only@127.0.0.1:5434/qolqa?schema=public
WEB_ORIGIN=http://localhost:5173
# Previews de Vercel (un solo *); vacío = solo WEB_ORIGIN
WEB_ORIGIN_PREVIEW=
TRUST_PROXY=1
LOG_LEVEL=debug
JWT_ACCESS_SECRET=<base64 de 32 bytes aleatorios>
JWT_MFA_SECRET=<base64 de 32 bytes aleatorios>
CSRF_SECRET=<base64 de 32 bytes aleatorios>
TOTP_ENCRYPTION_KEY=<base64 de 32 bytes aleatorios>
BCRP_BASE_URL=https://estadisticas.bcrp.gob.pe/estadisticas/series/api

# Monitorización (opcional; sin DSN Sentry queda desactivado)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
