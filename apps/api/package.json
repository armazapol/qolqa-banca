{
  "name": "@qolqa/api",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "api",
    "targets": {
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/pnpm-workspace.yaml",
          "{workspaceRoot}/package.json",
          {
            "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execSync('pnpm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
          }
        ],
        "outputs": [
          "{workspaceRoot}/apps/api/dist/package.json",
          "{workspaceRoot}/apps/api/dist/pnpm-lock.yaml",
          "{workspaceRoot}/apps/api/dist/pnpm-workspace.yaml",
          "{workspaceRoot}/apps/api/dist/patches",
          "{workspaceRoot}/apps/api/dist/local_path_modules"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/api/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "api:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "api:build:development"
          },
          "production": {
            "buildTarget": "api:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        },
        "dependsOn": [
          "^build",
          "prisma-generate"
        ]
      },
      "prisma-generate": {
        "cache": true,
        "command": "prisma generate",
        "options": {
          "cwd": "apps/api"
        },
        "inputs": [
          "{projectRoot}/prisma/schema.prisma",
          "{projectRoot}/prisma.config.ts"
        ],
        "outputs": [
          "{projectRoot}/src/generated/prisma"
        ]
      },
      "db-migrate": {
        "command": "prisma migrate dev",
        "options": {
          "cwd": "apps/api"
        }
      },
      "db-deploy": {
        "command": "prisma migrate deploy",
        "options": {
          "cwd": "apps/api"
        }
      },
      "db-seed": {
        "command": "prisma db seed",
        "options": {
          "cwd": "apps/api"
        }
      },
      "build": {
        "dependsOn": [
          "^build",
          "prisma-generate"
        ]
      },
      "typecheck": {
        "dependsOn": [
          "^typecheck",
          "prisma-generate"
        ]
      },
      "lint": {
        "dependsOn": [
          "prisma-generate"
        ]
      },
      "openapi": {
        "dependsOn": [
          "build"
        ],
        "command": "node apps/api/dist/main.js --emit-openapi apps/api/openapi.json",
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/openapi.json"
        ],
        "cache": true
      }
    },
    "tags": [
      "type:app",
      "scope:api"
    ]
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^13.4.5",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/graphql": "^13.4.5",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.2.7",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^11.2.7",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@qolqa/contracts": "workspace:*",
    "@sentry/nestjs": "^11.8.0",
    "cookie-parser": "^1.4.7",
    "graphql": "^16.14.2",
    "helmet": "^8.3.0",
    "nestjs-pino": "^5.3.1",
    "nestjs-zod": "^5.5.0",
    "otplib": "^13.5.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "socket.io": "^4.8.4",
    "tslib": "^2.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@sentry/webpack-plugin": "^11.8.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "pino-pretty": "^13.2.0",
    "prisma": "7.10.1",
    "tsx": "^4.23.15"
  }
}
