    "/api/transfers": {
      "post": {
        "operationId": "transfersCreate",
        "parameters": [
          {
            "name": "idempotency-key",
            "in": "header",
            "description": "UUID único por operación",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTransferDto"
              }
            }
          }
