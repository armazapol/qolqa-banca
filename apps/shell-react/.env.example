# Variables públicas del shell (se incrustan en el build). Todas opcionales:
# sin ellas, GA4 y Sentry quedan desactivados (ADR-0021).

# Google Analytics 4 (solo se carga con consentimiento)
VITE_GA_MEASUREMENT_ID=

# Sentry (navegador y SSR)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# Origen del BFF para WebSocket. En local: http://localhost:3000
VITE_WS_URL=http://localhost:3000
