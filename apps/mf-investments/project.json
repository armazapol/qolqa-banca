{
  "name": "mf-investments",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "inv",
  "sourceRoot": "apps/mf-investments/src",
  "tags": ["type:app", "scope:investments"],
  "targets": {
    "build": {
      "executor": "@angular-architects/native-federation:build",
      "options": {
        "cacheExternalArtifacts": true,
        "tsConfig": "apps/mf-investments/tsconfig.federation.json"
      },
      "configurations": {
        "production": {
          "target": "mf-investments:esbuild:production"
        },
        "development": {
          "target": "mf-investments:esbuild:development",
          "dev": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-architects/native-federation:build",
      "options": {
        "target": "mf-investments:serve-original:development",
        "tsConfig": "apps/mf-investments/tsconfig.federation.json",
        "rebuildDelay": 500,
        "cacheExternalArtifacts": true,
        "dev": true,
        "devServer": true,
        "port": 0
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{projectRoot}/test-output/jest/coverage"],
      "options": {
        "jestConfig": "apps/mf-investments/jest.config.cts",
        "tsConfig": "apps/mf-investments/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "mf-investments:build",
        "port": 4201,
        "staticFilePath": "dist/apps/mf-investments/browser",
        "spa": true
      }
    },
    "esbuild": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/mf-investments",
        "browser": "apps/mf-investments/src/main.ts",
        "tsConfig": "apps/mf-investments/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/mf-investments/public"
          }
        ],
        "styles": ["apps/mf-investments/src/styles.scss"],
        "polyfills": ["es-module-shims"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "12kb",
              "maximumError": "16kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve-original": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 4201
      },
      "configurations": {
        "production": {
          "buildTarget": "mf-investments:esbuild:production"
        },
        "development": {
          "buildTarget": "mf-investments:esbuild:development"
        }
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "cwd": "apps/mf-investments",
        "commands": [
          "tsc --noEmit -p tsconfig.app.json",
          "tsc --noEmit -p tsconfig.spec.json"
        ],
        "parallel": false
      }
    }
  }
}
